---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/common/Icon.astro';
---
<BaseLayout title="Página no encontrada" noindex><section class="container not-found"><Icon name="star" size={52} /><p class="eyebrow">ERROR 404</p><h1>Este detalle se nos escapó</h1><p>La página que buscas no está aquí, pero aún hay muchas creaciones por descubrir.</p><a href="/catalogo/" class="button button-primary">Volver al catálogo <Icon name="arrow" /></a></section></BaseLayout>
