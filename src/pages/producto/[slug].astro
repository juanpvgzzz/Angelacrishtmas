---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';
// Compatibilidad: solo carcasas; los datos siempre se consultan en Supabase.
export function getStaticPaths() { return products.map(({ slug }) => ({ params: { slug } })); }
---
<BaseLayout title="Producto"><div class="container product-page" data-live-product data-slug={Astro.params.slug}><h1>Detalle del producto</h1><p role="status">Cargando producto…</p></div></BaseLayout>
<script>import '../../scripts/public-catalog';</script>
