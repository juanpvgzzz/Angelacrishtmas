---
import { sections, sectionUrl } from '../../config/sections';
interface Props { selected?: string }
const { selected = '' } = Astro.props;
---
<nav class="section-tabs" aria-label="Secciones del catálogo">
  <a href="/catalogo/" aria-current={!selected ? 'page' : undefined}>Todas las creaciones</a>
  {sections.map(section => <a href={sectionUrl(section.id)} aria-current={selected === section.id ? 'page' : undefined}>{section.name}</a>)}
</nav>
<style is:global>
  .section-tabs { display: flex; flex-wrap: wrap; gap: 8px 24px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
  .section-tabs a { display: inline-flex; align-items: center; min-height: 48px; padding: 10px 0; border-bottom: 3px solid transparent; font-weight: 600; color: var(--forest); }
  .section-tabs a[aria-current='page'] { color: var(--red); border-bottom-color: var(--red); }
</style>
