---
import LiveCatalog from './LiveCatalog.astro';
import Icon from '../common/Icon.astro';
const isHome = Astro.url.pathname === '/';
---
<div class="container storefront">
  <form class="mobile-search search-field" action="/catalogo/" role="search" aria-label="Buscar en el catálogo">
    <Icon name="search" size={18} /><input type="search" name="q" aria-label="Buscar productos" placeholder="Buscar creaciones..." data-catalog-search autocomplete="off" />
  </form>
  {isHome && <section class="storefront-intro" aria-labelledby="storefront-intro-title">
    <div class="storefront-intro-copy">
      <p class="storefront-intro-kicker">ÁMELA · Hecho a mano con amor</p>
      <h2 id="storefront-intro-title">Regalos que guardan <em>historias</em></h2>
      <p class="storefront-intro-description">Piezas artesanales creadas con calma, cariño y pequeños detalles para momentos que merecen quedarse.</p>
      <a class="storefront-intro-link" href="#creaciones">Descubre nuestras creaciones <span aria-hidden="true">↗</span></a>
    </div>
    <span class="storefront-intro-flower" aria-hidden="true">✳</span>
  </section>}
  <section class="collections-section" id="colecciones" aria-labelledby="collections-title" hidden>
    <div class="shop-heading"><h2 id="collections-title">Categorías</h2><a href="/catalogo/#creaciones">Ver todas</a></div>
    <div data-home-categories></div>
  </section>
  <section class="featured-section" id="destacadas" aria-labelledby="featured-title" hidden>
    <div class="shop-heading"><h2 id="featured-title">Creaciones destacadas</h2><a href="#destacadas" data-expand-carousel aria-expanded="false">Ver todas</a></div>
    <div data-featured-products></div>
  </section>
  <section class="banner-carousel" aria-label="Campañas ÁMELA" aria-roledescription="carrusel" hidden>
    <div class="banner-track" tabindex="0" aria-label="Campañas: desliza o usa las flechas del teclado"></div>
    <div class="banner-arrows"><button type="button" data-banner-direction="-1" aria-label="Banner anterior">‹</button><button type="button" data-banner-direction="1" aria-label="Banner siguiente">›</button></div>
    <div class="banner-pagination" aria-label="Elegir banner"></div>
  </section>
  <section class="shop-catalog" id="creaciones" aria-labelledby="catalog-title">
    <div class="shop-heading"><h1 id="catalog-title">Todas nuestras creaciones</h1></div>
    <div class="catalog-managed-copy"><span data-catalog-eyebrow></span><span data-catalog-description></span></div>
    <LiveCatalog />
  </section>
  <section class="shop-note" id="como-comprar"><Icon name="needle" /><div><h2>Lo hacemos a tu medida</h2><p>Elige tu pieza y conversemos por WhatsApp sobre colores, tiempos y personalización. Elaboramos tu pedido con un anticipo del 50%.</p></div><a class="text-link" href="#contacto">Conversemos <Icon name="arrow" size={18} /></a></section>
</div>
<script>
function initBanners() {
  const track = document.querySelector<HTMLElement>('.banner-track');
  const dots = document.querySelectorAll<HTMLButtonElement>('[data-banner-page]');
  if (!track) return;
  const slides = Array.from(track.children) as HTMLElement[];
  if (!slides.length) return;
  const go = (index: number) => track.scrollTo({left: slides[index].offsetLeft - slides[0].offsetLeft, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
  dots.forEach((dot,index)=>dot.addEventListener('click',()=>go(index)));
  document.querySelectorAll<HTMLButtonElement>('[data-banner-direction]').forEach(button=>button.onclick=()=>{const index=Array.from(dots).findIndex(d=>d.getAttribute('aria-pressed')==='true');go((Math.max(0,index)+(Number(button.dataset.bannerDirection))+slides.length)%slides.length);});
  track.addEventListener('scroll',()=>{const i = slides.reduce((best,slide,index)=>Math.abs(slide.offsetLeft-slides[0].offsetLeft-track.scrollLeft)<Math.abs(slides[best].offsetLeft-slides[0].offsetLeft-track.scrollLeft)?index:best,0);dots.forEach((d,n)=>d.setAttribute('aria-pressed',String(n===i)));},{passive:true});
  track.addEventListener('keydown',event=>{if(event.target!==track || !['ArrowLeft','ArrowRight'].includes(event.key))return;event.preventDefault();const index=Array.from(dots).findIndex(d=>d.getAttribute('aria-pressed')==='true');go(Math.max(0,Math.min(slides.length-1,index+(event.key==='ArrowRight'?1:-1))));});
}
window.addEventListener('banners:rendered', initBanners);
document.querySelectorAll<HTMLAnchorElement>('[data-expand-carousel]').forEach(link => link.addEventListener('click', event => {
  event.preventDefault();
  const section = link.closest<HTMLElement>('section');
  if (!section) return;
  const expanded = section.classList.toggle('is-expanded');
  link.setAttribute('aria-expanded', String(expanded));
  link.textContent = expanded ? 'Cerrar' : 'Ver todas';
  if (expanded) section.scrollIntoView({ block: 'start' });
}));
</script>
